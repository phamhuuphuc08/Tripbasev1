// TripBase — Prisma schema
// Mirrors the data model in docs/PRODUCT_SPEC.md (mục 12).
// This is a structural first pass: fields/relations may be refined as each
// feature module (see src/features/*) is implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlanVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum PlanStatus {
  IDEA
  SCHEDULED
  COMPLETED
}

enum TravelPace {
  RELAXED
  NORMAL
  BUSY
}

enum CollaboratorRole {
  VIEWER
  EDITOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ShareLinkType {
  VIEW
  EDIT
}

enum InteractionType {
  LIKE
  BOOKMARK
}

enum ChecklistStatus {
  PENDING
  DONE
}

enum VoteType {
  UP
  DOWN
}

enum TargetType {
  PLACE
  ITINERARY_ITEM
}

enum NegativeSignalType {
  CLOSED
  PRICE_MISMATCH
  OTHER
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  image           String?
  bio             String?
  travelStyle     String?  @map("travel_style")
  budgetLevel     String?  @map("budget_level")
  travelInterests String[] @default([]) @map("travel_interests")
  passwordHash    String?  @map("password_hash")
  sessionVersion  Int      @default(0) @map("session_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  trips               Trip[]               @relation("TripOwner")
  locationTags        LocationTag[]        @relation("TagOwner")
  collaboratorOn      Collaborator[]       @relation("CollaboratorUser")
  invitesSent         Collaborator[]       @relation("CollaboratorInviter")
  tripInvitationsSent TripInvitation[]     @relation("TripInvitationInviter")
  shareLinksCreated   ShareLink[]
  interactions        Interaction[]
  planCopiesMade      PlanCopy[]
  creatorReputation   CreatorReputation?
  citationsMade       Citation[]           @relation("CiterUser")
  votes               Vote[]
  comments            Comment[]
  expensesPaid        Expense[]
  checklistAssigned   ChecklistItem[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Trip / Plan
// ---------------------------------------------------------------------------

model Trip {
  id               String         @id @default(cuid())
  name             String
  destination      String
  coverImageUrl    String?        @map("cover_image_url")
  startDate        DateTime?      @map("start_date")
  endDate          DateTime?      @map("end_date")
  currency         String         @default("VND")
  ownerId          String         @map("owner_id")
  owner            User           @relation("TripOwner", fields: [ownerId], references: [id])
  visibility       PlanVisibility @default(PRIVATE)
  status           PlanStatus     @default(IDEA)
  verifiedByAuthor Boolean        @default(false) @map("verified_by_author")

  travelerCount Int        @default(1) @map("traveler_count")
  budgetTarget  Decimal?   @map("budget_target")
  pace          TravelPace @default(NORMAL)
  travelStyle   String[]   @default([]) @map("travel_style")

  forkedFromPlanId String? @map("forked_from_plan_id")
  forkedFrom       Trip?   @relation("PlanFork", fields: [forkedFromPlanId], references: [id])
  forks            Trip[]  @relation("PlanFork")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  travelers        Traveler[]
  itineraryItems   ItineraryItem[]
  bookings         Booking[]
  expenses         Expense[]
  checklistItems   ChecklistItem[]
  collaborators    Collaborator[]
  invitations      TripInvitation[]
  shareLinks       ShareLink[]
  interactions     Interaction[]
  citations        Citation[]
  copiesOfThisPlan PlanCopy[]       @relation("OriginalPlan")
  copyRecord       PlanCopy?        @relation("CopyPlan")
  planReputation   PlanReputation?
  storySlides      StorySlide[]

  @@index([ownerId])
  @@index([visibility, status])
  @@map("trips")
}

model Traveler {
  id          String   @id @default(cuid())
  tripId      String   @map("trip_id")
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  ageGroup    String?  @map("age_group")
  preferences String[]

  @@index([tripId])
  @@map("travelers")
}

// ---------------------------------------------------------------------------
// Place / LocationTag / Tip
// ---------------------------------------------------------------------------

model Place {
  id             String   @id @default(cuid())
  name           String
  latitude       Float?
  longitude      Float?
  category       String?
  openingHours   String?  @map("opening_hours")
  costEstimate   Decimal? @map("cost_estimate")
  citeTrustScore Float    @default(0) @map("cite_trust_score")

  itineraryItems ItineraryItem[]
  citations      Citation[]

  @@map("places")
}

model LocationTag {
  id                    String        @id @default(cuid())
  ownerId               String        @map("owner_id")
  owner                 User          @relation("TagOwner", fields: [ownerId], references: [id])
  title                 String
  content               String?
  category              String?
  latitude              Float?
  longitude             Float?
  openingHours          String?       @map("opening_hours")
  possibleDuplicateOfId String?       @map("possible_duplicate_of")
  possibleDuplicateOf   LocationTag?  @relation("TagDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicates            LocationTag[] @relation("TagDuplicate")
  citeTrustScore        Float         @default(0) @map("cite_trust_score")
  createdAt             DateTime      @default(now()) @map("created_at")

  itineraryItems ItineraryItem[]
  citations      Citation[]

  @@index([ownerId])
  @@map("location_tags")
}

// ---------------------------------------------------------------------------
// Itinerary / Budget / Booking / Checklist
// ---------------------------------------------------------------------------

model ItineraryItem {
  id            String       @id @default(cuid())
  tripId        String       @map("trip_id")
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day           Int
  title         String
  startTime     DateTime?    @map("start_time")
  endTime       DateTime?    @map("end_time")
  placeId       String?      @map("place_id")
  place         Place?       @relation(fields: [placeId], references: [id])
  locationTagId String?      @map("location_tag_id")
  locationTag   LocationTag? @relation(fields: [locationTagId], references: [id])
  notes         String?
  sortOrder     Int          @default(0) @map("sort_order")

  copiedFromItemId String? @map("copied_from_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  votes    Vote[]
  comments Comment[]

  @@index([tripId, day, sortOrder])
  @@map("itinerary_items")
}

model Booking {
  id               String    @id @default(cuid())
  tripId           String    @map("trip_id")
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type             String
  provider         String?
  confirmationCode String?   @map("confirmation_code")
  fileUrl          String?   @map("file_url")
  dateTime         DateTime? @map("date_time")

  @@index([tripId])
  @@map("bookings")
}

model Expense {
  id           String   @id @default(cuid())
  tripId       String   @map("trip_id")
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category     String
  amount       Decimal
  note         String?
  paidById     String   @map("paid_by")
  paidBy       User     @relation(fields: [paidById], references: [id])
  splitBetween String[] @map("split_between")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("expenses")
}

model ChecklistItem {
  id           String          @id @default(cuid())
  tripId       String          @map("trip_id")
  trip         Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime?       @map("due_date")
  assignedToId String?         @map("assigned_to")
  assignedTo   User?           @relation(fields: [assignedToId], references: [id])
  status       ChecklistStatus @default(PENDING)

  @@index([tripId])
  @@map("checklist_items")
}

// ---------------------------------------------------------------------------
// Trip Story
// ---------------------------------------------------------------------------

model StorySlide {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day       Int?
  caption   String
  theme     String   @default("SUNSET")
  photo     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("story_slides")
}

// ---------------------------------------------------------------------------
// Group collaboration
// ---------------------------------------------------------------------------

model Vote {
  id         String         @id @default(cuid())
  targetType TargetType     @map("target_type")
  itemId     String?        @map("item_id")
  item       ItineraryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id])
  voteType   VoteType       @map("vote_type")
  createdAt  DateTime       @default(now()) @map("created_at")

  // One vote per person per item — casting again either changes or
  // retracts it (src/server/services/itinerary.service.ts#voteItineraryItem),
  // never stacks.
  @@unique([itemId, userId])
  @@index([targetType, itemId, userId])
  @@map("votes")
}

model Comment {
  id         String         @id @default(cuid())
  targetType TargetType     @map("target_type")
  itemId     String?        @map("item_id")
  item       ItineraryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id])
  content    String
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Share & Permission
// ---------------------------------------------------------------------------

model Collaborator {
  id          String           @id @default(cuid())
  planId      String           @map("plan_id")
  plan        Trip             @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String           @map("user_id")
  user        User             @relation("CollaboratorUser", fields: [userId], references: [id])
  role        CollaboratorRole
  invitedById String           @map("invited_by")
  invitedBy   User             @relation("CollaboratorInviter", fields: [invitedById], references: [id])
  invitedAt   DateTime         @default(now()) @map("invited_at")

  @@unique([planId, userId])
  @@index([userId])
  @@index([planId, role])
  @@map("collaborators")
}

model TripInvitation {
  id     String @id @default(cuid())
  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  email  String
  role   CollaboratorRole
  status InvitationStatus @default(PENDING)

  invitedById String @map("invited_by")
  invitedBy   User   @relation("TripInvitationInviter", fields: [invitedById], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  respondedAt DateTime? @map("responded_at")

  @@unique([tripId, email])
  @@index([tripId, status])
  @@index([email, status])
  @@index([invitedById])
  @@map("trip_invitations")
}

model ShareLink {
  id          String        @id @default(cuid())
  planId      String        @map("plan_id")
  plan        Trip          @relation(fields: [planId], references: [id], onDelete: Cascade)
  token       String        @unique
  type        ShareLinkType
  createdById String        @map("created_by")
  createdBy   User          @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?     @map("expires_at")
  revokedAt   DateTime?     @map("revoked_at")

  @@index([planId])
  @@map("share_links")
}

// ---------------------------------------------------------------------------
// Light-weight interactions
// ---------------------------------------------------------------------------

model Interaction {
  id        String          @id @default(cuid())
  planId    String          @map("plan_id")
  plan      Trip            @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id])
  type      InteractionType
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([planId, userId, type])
  @@map("interactions")
}

// ---------------------------------------------------------------------------
// CopyPlan & Reputation
// ---------------------------------------------------------------------------

model PlanCopy {
  id     String @id @default(cuid())
  planId String @unique @map("plan_id")
  plan   Trip   @relation("CopyPlan", fields: [planId], references: [id], onDelete: Cascade)

  originalPlanId String @map("original_plan_id")
  originalPlan   Trip   @relation("OriginalPlan", fields: [originalPlanId], references: [id])

  copierUserId String @map("copier_user_id")
  copierUser   User   @relation(fields: [copierUserId], references: [id])

  // Device guardrail:
  // chỉ lưu SHA-256 hash, không lưu device ID gốc
  copierDeviceHash String? @map("copier_device_hash")

  copiedAt DateTime @default(now()) @map("copied_at")

  initialItemCount Int    @default(0) @map("initial_item_count")
  retentionRate    Float? @map("retention_rate")

  completed      Boolean @default(false)
  postTripRating Float?  @map("post_trip_rating")

  @@index([originalPlanId])
  @@index([originalPlanId, copierDeviceHash])
  @@map("plan_copies")
}

model CreatorReputation {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  copyplanScore Float    @default(0) @map("copyplan_score")
  totalPlans    Int      @default(0) @map("total_plans")
  totalCopies   Int      @default(0) @map("total_copies")
  lastUpdated   DateTime @updatedAt @map("last_updated")

  @@map("creator_reputations")
}

model Citation {
  id            String       @id @default(cuid())
  placeId       String?      @map("place_id")
  place         Place?       @relation(fields: [placeId], references: [id])
  locationTagId String?      @map("tip_id")
  locationTag   LocationTag? @relation(fields: [locationTagId], references: [id])
  planId        String       @map("plan_id")
  plan          Trip         @relation(fields: [planId], references: [id], onDelete: Cascade)
  citerUserId   String       @map("citer_user_id")
  citerUser     User         @relation("CiterUser", fields: [citerUserId], references: [id])
  ownerIdOfTag  String       @map("owner_id_of_tag")
  isSelfCite    Boolean      @default(false) @map("is_self_cite")
  verifiedVisit Boolean      @default(false) @map("verified_visit")

  negativeSignalType NegativeSignalType? @map("negative_signal_type")
  negativeSignalNote String?             @map("negative_signal_note")
  negativeSignalAt   DateTime?           @map("negative_signal_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([planId])
  @@map("citations")
}

model PlanReputation {
  id     String @id @default(cuid())
  planId String @unique @map("plan_id")
  plan   Trip   @relation(fields: [planId], references: [id], onDelete: Cascade)

  copyplanScore Float @default(0) @map("copyplan_score")

  eligibleCopyCount     Int   @default(0) @map("eligible_copy_count")
  adjustedCopyVolume    Float @default(0) @map("adjusted_copy_volume")
  averageRetentionRate  Float @default(0) @map("average_retention_rate")
  completionRate        Float @default(0) @map("completion_rate")
  averagePostTripRating Float @default(0) @map("average_post_trip_rating")

  diversityBonus Float @default(0) @map("diversity_bonus")
  decay          Float @default(0)

  lastCopyAt  DateTime? @map("last_copy_at")
  lastUpdated DateTime  @updatedAt @map("last_updated")

  @@index([copyplanScore])
  @@map("plan_reputations")
}
