# Copy to .env and fill in real values. Never commit .env*.

# PostgreSQL connection string (see docs/PRODUCT_SPEC.md mục 15).
# Matches the credentials in docker-compose.yml's `db` service — if you run
# `docker compose up -d db` for local Postgres, this value works as-is.
DATABASE_URL="postgresql://tripbase:tripbase@localhost:5432/tripbase"

# NODE_ENV is set automatically by Next.js; listed here for reference only.
# NODE_ENV="development"
